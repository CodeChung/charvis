{
  "name": "React-performancetimeline",
  "version": "0.85.2",
  "summary": "React performance timeline utilities",
  "homepage": "https://reactnative.dev/",
  "license": "MIT",
  "authors": "Meta Platforms, Inc. and its affiliates",
  "platforms": {
    "ios": "15.1"
  },
  "source": {
    "git": "https://github.com/facebook/react-native.git",
    "tag": "v0.85.2"
  },
  "source_files": "**/*.{cpp,h}",
  "header_dir": "react/performance/timeline",
  "exclude_files": "tests",
  "pod_target_xcconfig": {
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "HEADER_SEARCH_PATHS": "\"${PODS_CONFIGURATION_BUILD_DIR}/React-jsinspector/jsinspector_modern.framework/Headers\" \"${PODS_CONFIGURATION_BUILD_DIR}/React-jsinspectortracing/jsinspector_moderntracing.framework/Headers\""
  },
  "dependencies": {
    "React-featureflags": [],
    "React-jsinspector": [],
    "React-jsinspectortracing": [],
    "React-timing": [],
    "React-perflogger": [],
    "ReactNativeDependencies": []
  }
}
